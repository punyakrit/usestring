{
  "name": "broadway-cheap-tickets",
  "version": "0.1.0",
  "description": "Rush and lottery offers for current Broadway shows, fetched through the String Web Access API.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx --env-file=.env src/index.ts",
    "fetch": "tsx --env-file=.env src/string.ts",
    "source:todaytix": "tsx --env-file=.env src/sources/todaytix.ts",
    "source:broadwaydirect": "tsx --env-file=.env src/sources/broadwaydirect.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  }
}
